# Configuracao operacional do FINCORE (TDS 27 e 30.1).
#
# Copie para .env e ajuste. O .env nao e versionado.
#
# Regra de configuracao: se alterar o valor pode mudar se uma conciliacao fecha ou nao,
# nao e variavel de ambiente — e regra de negocio, e mora em tabela, auditada e capturada
# no snapshot da execucao (TDS 30.1).

# --- Banco (M0) --------------------------------------------------------------
# Lidos pelo docker-compose e pela aplicacao. O perfil local tem valores padrao que so
# alcancam o contêiner desta maquina; dev e producao exigem estas variaveis.
FINCORE_DB_NAME=fincore
FINCORE_DB_USERNAME=fincore
FINCORE_DB_PASSWORD=fincore
FINCORE_DB_PORT=5432
FINCORE_DB_URL=jdbc:postgresql://localhost:5432/fincore

# --- Aplicacao (M0) ----------------------------------------------------------
FINCORE_SERVER_PORT=8080
# Versao do conjunto de regras de matching, exposta em /actuator/info (TDS 30.2).
FINCORE_RULE_SET_VERSION=1

# --- Variaveis dos proximos milestones ---------------------------------------
# Listadas aqui como referencia da tabela do TDS 27. Nenhuma e lida hoje: cada uma entra
# no milestone que a usa, junto com o codigo que a consome.
#
# M2  FINCORE_JWT_SECRET            (>= 256 bits)
# M2  FINCORE_JWT_ACCESS_TTL
# M2  FINCORE_JWT_REFRESH_TTL
# M2  FINCORE_CORS_ORIGIN           (nunca "*")
# M4  FINCORE_BUSINESS_TIMEZONE
# M6  FINCORE_FILE_STORAGE_PATH
# M6  FINCORE_MAX_UPLOAD_BYTES
# M6  FINCORE_MAX_UPLOAD_LINES
# M8  FINCORE_RABBIT_HOST / _PORT / _USERNAME / _PASSWORD
# M11 FINCORE_RUN_FAILURE_RATE_ABORT
# M15 FINCORE_SWEEP_CRON
# M17 NEXT_PUBLIC_API_BASE_URL
